# Shared local/deployment configuration
# Copy to .env for local development. Never commit .env.

# Frontend (Vite exposes only VITE_* values to the browser)
VITE_BACKEND_URL=http://localhost:4000
VITE_FRONTEND_URL=http://localhost:5173

# Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:5000

# Optional database connection. Leave empty for prediction-only local use.
MONGO_URI=

# Required only if authentication is added later.
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
